# Environments, toolchains and caches (rebuilt locally, see README)
.venv/
.venv-train/
.uv/
cache/
__pycache__/
*.pyc

# Downloaded models and binaries (official sources; fingerprints in models/manifests/)
bin/
models/*
!models/manifests/

# Datasets, generated training data, recordings and audio (licences and privacy: never committed)
data/*
!data/tests/
data/tests/**/audio/
data/tests/timing/
!data/tests-fresh/
data/tests-fresh/**/audio/
!data/tests-public/
data/tests-public/**/audio/
sessions/
reference/
logs/
*.wav
*.flac
*.mp3
*.npy
*.gguf
*.safetensors
*.pt
*.onnx

# The owner's held-out test calls stay private: the list of their ids and the fingerprints of the files made from
# them (tools/build_testsets.py keeps both in data/tests/; ignored anywhere in case a copy lands elsewhere)
private_calls.json
HASHES-private.txt
